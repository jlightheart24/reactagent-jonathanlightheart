# Copy to .env and replace the placeholder keys with your assigned credential.
# Based on U0-HW-09-materials/model-service.env.example (host and model adjusted; see README).
EMBEDDING_BASE_URL=http://golem:4000/v1
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_KEY=student-should-use-their-own

LLM_BASE_URL=http://golem:4000/v1
# The materials name Qwen3.8-27B; use a model your key is authorized for.
LLM_MODEL=Qwen3.8-Flash-Next
LLM_API_KEY=student-should-use-their-own

